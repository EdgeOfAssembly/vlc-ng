@@ -1491,7 +1492,16 @@
 
     /* do not flush buffers if codec hasn't been opened (theora/vorbis/VC1) */
     if( avcodec_is_open( ctx ) )
+    {
+        /* Temporarily raise the log level to suppress harmless "get_buffer()
+         * failed" / "no frame!" messages from the decoder on shutdown.
+         * These are common (and expected) when there are delayed frames
+         * and the video output is being closed at the same time. */
+        int saved_level = av_log_get_level();
+        av_log_set_level( AV_LOG_FATAL );
